# Copy to fetch_data/.env.local for local debug. Never commit .env.local.
# In GitHub Actions, set the same keys as repo secrets instead.

# Alectra portal login (no 2FA today)
ALECTRA_ACCOUNT_NAME=
ALECTRA_ACCOUNT_NUMBER=
ALECTRA_PHONE=
# Meter / service-point row identifier on the data page (e.g. 11025818)
ALECTRA_METER_ID=

# Optional
# ALECTRA_LOGIN_URL=https://alectrautilitiesgbportal.savagedata.com/Connect/Authorize?returnUrl=https%3A%2F%2Falectrautilitiesgbportal.savagedata.com%2F
# How far back the From Date goes when downloading; default 14 days
# ALECTRA_LOOKBACK_DAYS=14

# Home Assistant target
HA_BASE_URL=http://localhost:8123
HA_TOKEN=

# Local debug flags
HEADLESS=0
# SAVE_LOCAL=./out.xml

# Enbridge Gas portal
ENBRIDGE_EMAIL=
ENBRIDGE_PASSWORD=
# Partial match for the service address shown in the Share My Data dropdown
ENBRIDGE_SERVICE_ADDRESS=

# Optional
# ENBRIDGE_LOGIN_URL=
# ENBRIDGE_LOOKBACK_DAYS=14

# Gmail 2FA (unused, reserved)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
